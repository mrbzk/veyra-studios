# Veyra Agent environment variables
# Copy to .env in the app folder (/var/www/veyra-agent/.env on the VPS)
# and fill in. Never commit .env: it is in .gitignore.
# After any change: pm2 restart veyra-agent --update-env


# ── ANTHROPIC ────────────────────────────────────────────
# console.anthropic.com → API Keys. Format: sk-ant-...
ANTHROPIC_API_KEY=


# ── STRIPE ───────────────────────────────────────────────
# Stripe → Developers → Webhooks → the endpoint
# https://srv.veyrastudios.agency/stripe-webhook → Signing secret.
# Events: checkout.session.completed, customer.created. Format: whsec_...
STRIPE_WEBHOOK_SECRET=


# ── NOTION ───────────────────────────────────────────────
# notion.so/my-integrations → Veyra Agent → Internal Integration Token.
# The integration must be connected to both databases below.
NOTION_API_KEY=

# Database IDs. Only change these if the databases are recreated.
NOTION_CLIENT_DB_ID=36d8e2ee-ae0c-8028-a00b-f15951998479
NOTION_PROJECT_TRACKER_ID=36d8e2ee-ae0c-80f4-9158-fffc22de55e2


# ── SLACK ────────────────────────────────────────────────
# api.slack.com/apps → Veyra Agent → OAuth & Permissions
# → Bot User OAuth Token. Format: xoxb-...
SLACK_BOT_TOKEN=

# api.slack.com/apps → Veyra Agent → Basic Information → App Credentials
# → Signing Secret (not the Client Secret or Verification Token).
# Required for /booked; also used to verify the other Slack routes.
SLACK_SIGNING_SECRET=

# Your Slack member ID (profile → ··· → Copy member ID). Invited to
# every new client channel. Format: U0XXXXXXX
SLACK_ADMIN_USER_ID=

# Optional: more team members to invite to every client channel,
# comma-separated member IDs.
SLACK_TEAM_MEMBER_IDS=

# Channel for internal alerts, without the #. The bot must be a member.
INTERNAL_SLACK_CHANNEL=production


# ── ONBOARDING ───────────────────────────────────────────
# Where clients book their kickoff call. Sent in the welcome
# message and the day 1/3/7 reminders.
KICKOFF_BOOKING_URL=https://veyrastudios.eu/onboarding


# ── SERVER ───────────────────────────────────────────────
# nginx proxies srv.veyrastudios.agency to this port.
PORT=3000
